{
  "name": "client",
  "private": true,
  "version": "1.0.15",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "start": "serve -s dist -l 8080",
    "deploy": "npm run deploy:patch",
    "deploy:patch": "npm version patch && npm run build && firebase deploy --except storage",
    "deploy:minor": "npm version minor && npm run build && firebase deploy --except storage",
    "deploy:major": "npm version major && npm run build && firebase deploy --except storage"
  },
  "dependencies": {
    "@google/genai": "^2.6.0",
    "firebase": "^12.12.1",
    "lucide-react": "^1.11.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "serve": "^14.2.6",
    "workbox-precaching": "^7.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.12.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^10.2.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.5.0",
    "sharp": "^0.34.5",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.58.2",
    "vite": "^8.0.10",
    "vite-plugin-pwa": "^1.2.0"
  }
}
